{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,__tests__/**,**/*.test.py,**/test_*.py,alembic/**}"
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/x-publish-due",
      "schedule": "*/5 * * * *"
    }
  ]
}
